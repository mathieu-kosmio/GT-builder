---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f5f6f8;
        --ink: #1c2433;
        --muted: #6b7686;
        --brand: #2f6f5e;
        --accent: #c6643a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.5;
      }
      main { max-width: 760px; margin: 0 auto; padding: 64px 24px; }
      .logo { font-weight: 800; font-size: 22px; color: var(--brand); }
      .logo span { color: var(--accent); }
      h1 { font-size: 30px; margin: 20px 0 8px; }
      .muted { color: var(--muted); }
      ul { padding-left: 18px; }
      a { color: var(--brand); }
    </style>
  </head>
  <body>
    <main>
      <div class="logo">GT<span>builder</span></div>
      <slot />
    </main>
  </body>
</html>
