# =============================================================================
# GT-builder - variables d'environnement (exemple)
# Copier en .env et renseigner. Ne jamais committer le .env reel.
# =============================================================================

# --- Domaine public (routage Caddy par sous-domaine) ---
PUBLIC_BASE_DOMAIN=gtbuilder.fr

# --- PostgreSQL (compte superadmin, gere par le conteneur) ---
POSTGRES_USER=gtbuilder_admin
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=gtbuilder

# --- Compte applicatif Postgres (droits limites, soumis au RLS) ---
# Cree par les scripts ./db/init au premier demarrage
APP_DB_USER=gtbuilder_app
APP_DB_PASSWORD=change-me-strong

# --- Valkey (cache + file de jobs) ---
VALKEY_PASSWORD=change-me-strong

# --- Secret de signature des sessions / JWT (32+ octets aleatoires) ---
AUTH_SECRET=change-me-with-openssl-rand-hex-32

# --- Stockage objet souverain compatible S3 (Scaleway / OVH / Garage) ---
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=gtbuilder-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- LLM souverain (Mistral via OVHcloud / Scaleway, endpoint OpenAI-compatible) ---
# Passe par LiteLLM ou directement vers l'endpoint du fournisseur
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-large-latest

# --- Transcription souveraine (endpoint managé OVH/Scaleway) ---
# En dev, pointer vers le service whisper local (profil local-ai) :
#   TRANSCRIBE_BASE_URL=http://whisper:9000
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=

# --- OPTION SSO (profil "sso") : Keycloak ---
KEYCLOAK_HOSTNAME=auth.gtbuilder.fr
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong
