{
  "name": "gtbuilder-app",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:worker": "tsup --watch --onSuccess \"node dist/worker.js\"",
    "build": "next build && pnpm run build:worker",
    "build:worker": "tsup",
    "start": "node server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "bullmq": "^5.34.6",
    "ioredis": "5.10.1",
    "jose": "^5.9.6",
    "next": "^15.5.4",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
